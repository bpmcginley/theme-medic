# Copy to .env for local dev.
PORT=3200

# Free Google PageSpeed Insights API key (https://console.cloud.google.com → enable
# "PageSpeed Insights API" → Credentials → API key). Without it, scans share an
# anonymous quota that is frequently exhausted (HTTP 429).
PSI_API_KEY=

# Free Neon Postgres connection string (https://neon.tech → create project → copy the
# connection string). Durably stores captured leads. If unset, leads are kept in memory
# only (fine for local testing; not durable across restarts).
DATABASE_URL=

# Resend API key (https://resend.com → free tier → API Keys) + a verified "from"
# address. When both are set, submitting the lead form actually emails the visitor
# their scan report. Until then, sends are just logged (see src/email.js) — the lead
# is still saved either way.
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Optional: query-param key required to read /internal/funnel-stats once traffic
# exists (e.g. /internal/funnel-stats?key=...). Leave unset for open access locally.
INTERNAL_STATS_KEY=
